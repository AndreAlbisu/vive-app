{
  "expo": {
    "name": "Vita",
    "slug": "vita",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "viveapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.andrealbisu.viveapp",
      "scheme": "viveapp",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png",
        "backgroundColor": "#FBF6EF"
      },
      "package": "com.andrealbisu.viveapp",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#ffffff",
          "defaultChannel": "default",
          "iosDisplayInForeground": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-web-browser",
      "expo-apple-authentication",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Vita necesita acceso a tus fotos para subir tu video de presentación.",
          "cameraPermission": "Vita necesita acceso a tu cámara para grabar tu video de presentación.",
          "microphonePermission": "Vita necesita acceso al micrófono para grabar tu video de presentación."
        }
      ],
      "expo-video",
      [
        "expo-calendar",
        {
          "calendarPermission": "Vita necesita acceso al calendario para agregar tus sesiones."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Vita necesita acceso al micrófono para grabar tus recursos de audio."
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d295d41b-9b35-4376-8b28-3997ad01cbf9"
      }
    },
    "owner": "vita-wellness-app"
  }
}
